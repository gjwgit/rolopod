<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: what GNOME Software, KDE Discover and Flathub show
     for the app. From the gjwgit/fluttertmpl Copier template, with the
     summary and description from .copier-answers.yml. @VERSION@ and
     @DATE@ are filled in from pubspec.yaml when the Flatpak is built. -->
<component type="desktop-application">
  <id>com.togaware.rolopod</id>
  <name>RoloPod</name>
  <summary>A privacy preserving rolodex for your Solid Pod</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="com.togaware">
    <name>Togaware</name>
  </developer>
  <url type="homepage">https://github.com/gjwgit/rolopod</url>
  <url type="bugtracker">https://github.com/gjwgit/rolopod/issues</url>
  <launchable type="desktop-id">com.togaware.rolopod.desktop</launchable>

  <description>
    <p>
      RoloPod collects your address books and contacts and stores them
      securely, encrypted, in your personal online data store (Pod) hosted
      by the Solid server of your choice.
    </p>
    <p>
      Import and export contacts as JSON, BBDB or vCard, view them as a PDF,
      keep track of birthdays, find duplicates, and share your contacts
      with others through your Pod.
    </p>
  </description>

  <categories>
    <category>Office</category>
    <category>ContactManagement</category>
  </categories>

  <keywords>
    <keyword>contacts</keyword>
    <keyword>address book</keyword>
    <keyword>rolodex</keyword>
    <keyword>solid</keyword>
    <keyword>pod</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
